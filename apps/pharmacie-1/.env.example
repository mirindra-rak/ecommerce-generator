# Connexion PostgreSQL (cf. docker-compose.yml ou PostgreSQL local)
DATABASE_URL="postgresql://pharmacie:pharmacie@localhost:5432/pharmacie?schema=public"

NODE_ENV=development

# Better Auth
# Générer un secret : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:4000"

# Compte admin initial (seed) — pnpm --filter pharmacie-1 seed:admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"
