// Schéma Prisma — modèle Silo (1 base = 1 pharmacie).
// ⛔ AUCUN tenant_id / table tenants : la séparation est au niveau du déploiement.
// Module `catalog` (story 01). Les autres modules seront ajoutés via migrations dédiées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  // Identifiant d'origine (fabricant PrestaShop) pour ré-import idempotent.
  externalId Int?     @unique

  // Contenu éditorial.
  shortDescription String?
  description      String?

  // Image (clé objet S3/MinIO).
  logoKey String?

  // SEO.
  metaTitle       String?
  metaDescription String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique // « URL simplifiée »
  position Int     @default(0)
  // Identifiant d'origine (catégorie PrestaShop) pour ré-import idempotent.
  externalId Int?  @unique
  // « Affichée » : visibilité côté boutique.
  active   Boolean @default(true)

  // Contenu éditorial (peut contenir du HTML issu de la migration ; rendu échappé).
  description      String?
  additionalInfo   String?
  shortDescription String?

  // SEO.
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])

  // Images (clés objet S3/MinIO ; remplies par la migration, upload différé).
  coverImageKey    String?
  thumbnailKey     String?
  menuThumbnailKey String?

  // Défauts douaniers (hérités par les produits côté PrestaShop).
  countryOfOrigin String?
  hsCode          String?

  // Arbre auto-référencé. onDelete: Restrict → on refuse de supprimer une catégorie
  // qui a des enfants (la règle métier fine est affinée en story 04).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  // Produits rattachés (M2M) + produits dont CETTE catégorie est la principale.
  products  Product[] @relation("ProductCategories")
  primaryOf Product[] @relation("ProductPrimaryCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model TaxRate {
  // Référentiel fiscal stable : IDs lisibles pour simplifier les seeds et migrations.
  id       String  @id
  code     String  @unique
  name     String
  rateBps  Int
  active   Boolean @default(true)
  position Int     @default(0)

  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  // Résumé court (équiv. PrestaShop `description_short`) ; rendu échappé côté storefront.
  shortDescription String?
  // SEO produit (parité avec Category).
  metaTitle       String?
  metaDescription String?
  // Identifiant d'origine (produit PrestaShop) pour ré-import idempotent.
  externalId  Int?    @unique
  // Type ouvert (String + union TS côté code) : ajouter un type ne demande pas de migration.
  productType String  @default("OTHER")
  // Attributs DESCRIPTIFS propres au vertical (parapharmacie : inci, precautions…).
  // Validés par attribute-set Zod selon productType. Les champs commerce restent en colonnes.
  attributes  Json    @default("{}")
  taxRateId   String
  taxRate     TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  // Marque optionnelle : supprimer une marque détache ses produits (SetNull).
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Catégories (M2M) : un produit peut appartenir à plusieurs catégories. Supprimer une
  // catégorie détache simplement le produit (lignes de jointure en cascade).
  categories Category[] @relation("ProductCategories")
  // Catégorie principale (canonical / fil d'Ariane), optionnelle. SetNull à la suppression.
  primaryCategoryId String?
  primaryCategory   Category? @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)

  options     ProductOption[]
  variants    ProductVariant[]
  media       ProductMedia[]
  facetValues ProductFacetValue[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([primaryCategoryId])
  @@index([brandId])
  @@index([taxRateId])
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductOptionValue {
  id       String               @id @default(cuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Référence interne optionnelle. Unique quand renseignée (PostgreSQL autorise plusieurs NULL).
  sku       String? @unique
  // Code-barres (EAN/CIP) : identifie LA déclinaison vendable, pas le produit regroupeur.
  ean       String? @unique
  // Prix HT en centimes (jamais de flottant pour la monnaie). TVA gérée par `pricing`.
  priceExclTax Int
  volume       String?
  stock        Int                  @default(0)
  optionValues VariantOptionValue[]

  // ── Inventory ──
  minOrderQty      Int                @default(1)
  stockLocation    String?
  lowStockThreshold Int?
  lowStockAlert    Boolean            @default(false)
  outOfStockBehavior OutOfStockBehavior @default(DEFAULT)
  stockMovements   StockMovement[]
  cartItems        CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Liaison variante ↔ valeur d'option (une variante = une valeur par axe).
model VariantOptionValue {
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductMedia {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Clé objet S3/MinIO — AUCUN binaire en base.
  storageKey String   @unique
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

// ───────────────────────── Inventory ─────────────────────────

enum OutOfStockBehavior {
  DENY
  ALLOW
  DEFAULT
}

enum StockMovementReason {
  MANUAL_ADJUSTMENT
  RECEPTION
  SALE
  RETURN
  CORRECTION
}

model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  stockAfter Int
  reason    StockMovementReason
  note      String?
  createdAt DateTime            @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ───────────────────────── Facettes (filtres produit) ─────────────────────────
// Taxonomie de facettes pilotée par la donnée (équiv. « Features » PrestaShop) : axes de
// FILTRAGE descriptifs (Nature, Conditionnement, Spécificité, Indication/CI). À distinguer
// des `ProductOption` (axes qui GÉNÈRENT des déclinaisons/SKU). Ajouter une facette ou une
// valeur = INSERT, jamais de migration. Le texte libre non filtré reste dans `attributes`.

model Facet {
  id       String       @id @default(cuid())
  code     String       @unique // "nature", "conditionnement", "specificite", "indication"
  name     String // libellé affiché : "Nature de produit"
  position Int          @default(0)
  values   FacetValue[]
}

model FacetValue {
  id       String              @id @default(cuid())
  facetId  String
  facet    Facet               @relation(fields: [facetId], references: [id], onDelete: Cascade)
  code     String // "collutoire", "sans-conservateur"
  label    String // "Collutoire", "Sans conservateur"
  position Int                 @default(0)
  products ProductFacetValue[]

  @@unique([facetId, code])
  @@index([facetId])
}

// Liaison M:N produit ↔ valeur de facette (un produit porte plusieurs valeurs).
model ProductFacetValue {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  facetValueId String
  facetValue   FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)

  @@id([productId, facetValueId])
  @@index([facetValueId]) // « tous les produits portant cette valeur » = le filtre
}

// ───────────────────────── Cart ─────────────────────────
// Panier d'achat. Un Cart est lié à un sessionToken (anonyme) et/ou un userId (connecté).

model Cart {
  id           String     @id @default(cuid())
  sessionToken String?    @unique
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id           String         @id @default(cuid())
  cartId       String
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity     Int
  priceExclTax Int
  taxRateBps   Int
  priceInclTax Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────
// Socle commun d'authentification. ⛔ Aucun tenant_id (modèle Silo).
// Champs cœur attendus par Better Auth + rôle métier.

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  sessions      Session[]
  accounts      Account[]
  carts         Cart[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
